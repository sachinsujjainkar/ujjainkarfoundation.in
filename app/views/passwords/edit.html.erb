<% content_for :title, t("auth.update_password_heading") %>

<h1 class="mb-6 text-h2 font-display text-ink"><%= t("auth.update_password_heading") %></h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-5" do |form| %>
  <div class="form-field">
    <label class="form-label" for="password"><%= t("auth.new_password") %></label>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
          id: "password", class: "form-input" %>
  </div>

  <div class="form-field">
    <label class="form-label" for="password_confirmation"><%= t("auth.confirm_password") %></label>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          id: "password_confirmation", class: "form-input" %>
  </div>

  <%= form.submit t("auth.save"), class: "btn btn-primary w-full" %>
<% end %>
