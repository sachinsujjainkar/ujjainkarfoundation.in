<% content_for :title, t("auth.forgot_password_heading") %>

<h1 class="mb-6 text-h2 font-display text-ink"><%= t("auth.forgot_password_heading") %></h1>

<%= form_with url: passwords_path, class: "flex flex-col gap-5" do |form| %>
  <div class="form-field">
    <label class="form-label" for="email_address"><%= t("auth.email_address") %></label>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], id: "email_address", class: "form-input" %>
  </div>

  <%= form.submit t("auth.email_reset_instructions"), class: "btn btn-primary w-full" %>
<% end %>
