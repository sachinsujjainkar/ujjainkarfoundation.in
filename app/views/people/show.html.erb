<% content_for :title, @person.name %>
<%= render "components/page_header", title: @person.name,
      breadcrumbs: [[t("navigation.home"), locale_root_path], [@person.name, request.path]] %>

<div class="container mx-auto flex flex-col gap-10 px-5 py-16 lg:flex-row lg:items-start">
  <aside class="flex flex-col items-center gap-4 text-center lg:w-64 lg:shrink-0 lg:items-start lg:text-left">
    <% if @person.photo.attached? %>
      <%= image_tag @person.photo, alt: "", class: "size-40 rounded-full object-cover" %>
    <% end %>
    <div>
      <% if @person.honorific.present? %>
        <p class="text-small text-ink-muted"><%= @person.honorific %></p>
      <% end %>
      <h2 class="text-h3 font-display"><%= @person.name %></h2>
      <% if @person.city.present? %>
        <p class="text-small text-ink-muted"><%= @person.city %></p>
      <% end %>
    </div>
    <% if @person.bio.present? %>
      <p class="measure text-body text-ink"><%= @person.bio %></p>
    <% end %>
  </aside>

  <div class="flex-1">
    <h2 class="mb-6 text-h3 font-display"><%= t("articles.related_articles") %></h2>
    <% if @articles.any? %>
      <div class="flex flex-col gap-6">
        <% @articles.each do |article| %>
          <article class="flex flex-col gap-1 border-b border-line pb-4 last:border-b-0">
            <span class="tag w-fit"><%= t("articles.types.#{article.article_type}") %></span>
            <h3 class="text-h3 font-display">
              <%= link_to article.headline, localized_detail_path(:articles, article.slug), class: "text-ink hover:text-brand-700" %>
            </h3>
            <p class="text-small text-ink-muted"><%= dateline(article.dateline_place, article.published_at) %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <%= render "components/empty_state", message: t("articles.index_empty") %>
    <% end %>
  </div>
</div>
