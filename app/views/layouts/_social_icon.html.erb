<%# Locals: platform (:facebook | :instagram | :youtube | :twitter)
    Monochrome, currentColor, single weight — no multicoloured brand icon
    set (docs/02-design-system.md). %>
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% case platform %>
  <% when :facebook %>
    <path d="M15 8h2V5h-2a4 4 0 0 0-4 4v2H9v3h2v6h3v-6h2.5l.5-3H14V9a1 1 0 0 1 1-1Z" />
  <% when :instagram %>
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
  <% when :youtube %>
    <rect x="2" y="5" width="20" height="14" rx="4" />
    <path d="M10 9.5 15 12l-5 2.5v-5Z" fill="currentColor" stroke="none" />
  <% when :twitter %>
    <path d="M20 5.5c-.7.4-1.5.6-2.3.8a3.4 3.4 0 0 0-5.8 3.1A9.6 9.6 0 0 1 4.9 5.9a3.4 3.4 0 0 0 1 4.5c-.6 0-1.2-.2-1.7-.4v.1a3.4 3.4 0 0 0 2.7 3.3c-.5.1-1 .2-1.6.1a3.4 3.4 0 0 0 3.2 2.4A6.8 6.8 0 0 1 3 17.4a9.6 9.6 0 0 0 5.2 1.5c6.3 0 9.7-5.2 9.7-9.7v-.4c.7-.5 1.3-1.1 1.8-1.8Z" />
  <% end %>
</svg>
