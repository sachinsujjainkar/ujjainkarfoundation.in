<%# Locals: items — Array of [label, url] pairs; last entry is the current page %>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <% items.each_with_index do |(label, url), index| %>
    <% is_last = index == items.length - 1 %>
    <% if is_last %>
      <span aria-current="page"><%= label %></span>
    <% else %>
      <%= link_to label, url %>
      <span aria-hidden="true">/</span>
    <% end %>
  <% end %>
</nav>

<%# BreadcrumbList structured data — see docs/04-routes.md, "SEO requirements per page". %>
<script type="application/ld+json">
  <%= json_escape({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => items.each_with_index.map do |(label, url), index|
      {
        "@type" => "ListItem",
        "position" => index + 1,
        "name" => label,
        "item" => url.to_s.start_with?("http") ? url : "#{request.base_url}#{url}"
      }
    end
  }.to_json).html_safe %>
</script>
