<%
  # SEO scaffolding: every page gets a title/description/canonical/OG/
  # Twitter set from these defaults; a page overrides by calling
  # content_for(:title | :meta_description | :canonical | :og_type) with
  # ONLY its own segment -- this partial does the composition, so pages
  # never have to repeat the site name or re-derive the canonical URL.
  page_title = content_for(:title)
  full_title = [ page_title, site_name ].compact_blank.join(" — ")
  meta_description = content_for(:meta_description).presence || t("common.registered_trust_description")
  canonical_url = content_for(:canonical).presence || request.original_url
%>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= full_title %></title>
    <meta name="description" content="<%= meta_description %>">
    <link rel="canonical" href="<%= canonical_url %>">

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Shivcharan Ujjainkar Foundation">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Open Graph + Twitter card. No og:image yet -- the default social
        card (assets-source/brand/og-image/) doesn't exist yet; omitted
        rather than pointing at a broken or invented placeholder. %>
    <meta property="og:site_name" content="<%= site_name %>">
    <meta property="og:title" content="<%= page_title.presence || site_name %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:locale" content="<%= I18n.locale == :mr ? "mr_IN" : "en_IN" %>">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= page_title.presence || site_name %>">
    <meta name="twitter:description" content="<%= meta_description %>">

    <%# Turbo 8 page morphing (preserves scroll + focus + form state across
        navigation) and native View Transitions between pages. Honours
        prefers-reduced-motion in app/assets/tailwind/base.css. %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <meta name="view-transition" content="same-origin">

    <%# Preload only the two body weights — the first-paint-critical fonts.
        Display/headline and heavier weights lazy-load via @font-face. %>
    <%= tag.link rel: "preload", href: asset_path("mukta-400.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= tag.link rel: "preload", href: asset_path("inter-400.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%# Reciprocal hreflang pair + x-default, on every page. See
        docs/04-routes.md, "SEO requirements per page". %>
    <% I18n.available_locales.each do |locale| %>
      <%= tag.link rel: "alternate", hreflang: locale, href: alternate_locale_url(locale) %>
    <% end %>
    <%= tag.link rel: "alternate", hreflang: "x-default", href: alternate_locale_url(:mr) %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# public/favicon.ico is what browsers request automatically at the
        root; referenced here too so the <link> is explicit. The other
        sizes live in app/assets/images and go through the asset pipeline
        (fingerprinted, cacheable). %>
    <%= favicon_link_tag "/favicon.ico" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>
    <%= favicon_link_tag "android-chrome-192x192.png", rel: "icon", type: "image/png", sizes: "192x192" %>
    <%= favicon_link_tag "android-chrome-512x512.png", rel: "icon", type: "image/png", sizes: "512x512" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content" class="skip-link"><%= t("common.skip_to_content") %></a>

    <%= render "layouts/header" %>
    <%= render "layouts/flash_messages" %>

    <main id="main-content">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
