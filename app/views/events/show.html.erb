<% content_for :title, @event.title %>
<% content_for :meta_description, @event.description.presence %>

<%= render "components/page_header", title: @event.title,
      breadcrumbs: [[t("navigation.home"), locale_root_path], [t("navigation.events"), localized_path(:events)], [@event.title, request.path]] %>

<div class="container mx-auto flex flex-col gap-10 px-5 py-16">
  <% if @event.hero_image.attached? %>
    <%# No named variants on Event#hero_image, same reasoning as
        Activity#hero_image -- original at natural size, cropped via CSS. %>
    <div class="aspect-[21/9] w-full overflow-hidden rounded-card bg-brand-100">
      <%= image_tag @event.hero_image, alt: "", class: "size-full object-cover", loading: "eager" %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <span class="tag"><%= @event.upcoming? ? t("common.upcoming") : t("common.past") %></span>
    <% if @event.starts_at.present? %>
      <p class="text-small text-ink-muted"><%= localized_date(@event.starts_at) %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
    <div class="flex flex-col gap-6 lg:col-span-2">
      <% if @event.description.present? %>
        <div class="measure text-body text-ink"><%= @event.description %></div>
      <% end %>

      <% if @event.youtube_id.present? %>
        <%= render "components/youtube_embed", youtube_id: @event.youtube_id, title: @event.title %>
      <% end %>

      <% if @event.event_photos.any? %>
        <section class="flex flex-col gap-4 border-t border-line pt-10">
          <h2 class="text-h2 font-display"><%= t("events.photos_heading") %></h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <% @event.event_photos.each do |photo| %>
              <figure class="photo-figure">
                <%= responsive_image_tag photo, sizes: "(min-width: 1024px) 33vw, 100vw" %>
                <% if photo.caption.present? %>
                  <figcaption class="photo-figure-caption">
                    <%= photo.caption %>
                    <% if photo.credit.present? %>
                      <span class="text-ink-muted"> — <%= photo.credit %></span>
                    <% end %>
                  </figcaption>
                <% end %>
              </figure>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @event.articles.any? %>
        <section class="flex flex-col gap-4 border-t border-line pt-10">
          <h2 class="text-h2 font-display"><%= t("events.coverage_heading") %></h2>
          <div class="flex flex-col gap-4">
            <% @event.articles.published.order(published_at: :desc).each do |article| %>
              <article class="flex flex-col gap-1 border-b border-line pb-4 last:border-b-0">
                <h3 class="text-body font-semibold">
                  <%= link_to article.headline, localized_detail_path(:articles, article.slug), class: "text-ink hover:text-brand-700" %>
                </h3>
                <p class="text-small text-ink-muted"><%= dateline(article.dateline_place, article.published_at) %></p>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="flex flex-col gap-4">
      <div class="card flex flex-col gap-2">
        <h2 class="text-h3 font-display"><%= t("common.venue") %></h2>
        <% if @event.venue_name.present? %>
          <p class="text-body font-semibold text-ink"><%= @event.venue_name %></p>
        <% end %>
        <% if @event.venue_address.present? %>
          <p class="text-small text-ink-muted"><%= @event.venue_address %></p>
        <% end %>
        <% if @event.venue_note.present? %>
          <p class="text-small text-ink-muted"><%= @event.venue_note %></p>
        <% end %>
      </div>

      <%= render "components/share_whatsapp", url: localized_detail_url(:events, @event.slug), text: @event.title %>
    </aside>
  </div>
</div>
