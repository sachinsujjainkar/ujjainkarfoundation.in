# Copy to .env (already git-ignored, see .gitignore's /.env*) and fill in
# real values for local dev, OR set these directly in Railway's environment
# variables for production -- never commit real secrets to this repo.

# Cloudflare R2 (config/storage.yml, Phase 06 media pipeline)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ujjainkar-media

# Outgoing mail (Brevo or Resend, per docs/06-infrastructure.md) -- not
# wired into config/environments/production.rb yet
MAIL_FROM_ADDRESS=no-reply@ujjainkarfoundation.in

# hCaptcha (contact + volunteer forms, Phase 05) -- not wired in yet at all
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
