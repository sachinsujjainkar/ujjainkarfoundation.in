<%# Locals: icon (:book | :award | :graduation_cap | :podium | :document | :heart)
    Monochrome line icons, single weight, currentColor -- see
    docs/02-design-system.md: "Not five different colours." %>
<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% case icon %>
  <% when :book %>
    <path d="M4 5.5c2-1 5-1 8 0v13c-3-1-6-1-8 0v-13Z" />
    <path d="M20 5.5c-2-1-5-1-8 0v13c3-1 6-1 8 0v-13Z" />
  <% when :award %>
    <circle cx="12" cy="9" r="5.5" />
    <path d="M9 13.5 7.5 21l4.5-2.5 4.5 2.5-1.5-7.5" />
  <% when :graduation_cap %>
    <path d="M2 9l10-4 10 4-10 4-10-4Z" />
    <path d="M6 11v5c0 1.1 2.7 2 6 2s6-.9 6-2v-5" />
    <path d="M22 9v6" />
  <% when :podium %>
    <path d="M6 21V10a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v11" />
    <path d="M4 21h16" />
    <circle cx="12" cy="5" r="2" />
  <% when :document %>
    <path d="M7 3h7l4 4v14H7V3Z" />
    <path d="M14 3v4h4" />
    <path d="M9.5 13h5M9.5 16.5h5" />
  <% when :heart %>
    <path d="M12 20.5s-7.5-4.6-9.5-9.3C.9 7.6 3 4.5 6.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.3 0 5.4 3.1 3.8 6.7-2 4.7-9.5 9.3-9.5 9.3Z" />
  <% end %>
</svg>
