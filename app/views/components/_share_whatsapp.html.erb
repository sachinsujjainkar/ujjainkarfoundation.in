<%#
  Locals: url, text (optional message to prefix the shared link)
  Icon stays monochrome currentColor, not WhatsApp's brand green — the
  design system's palette discipline (one accent per screen, no
  multicoloured icon sets) applies to this button too.
%>
<%
  share_text = [local_assigns[:text], url].compact.join(" ")
  wa_href = "https://wa.me/?text=#{ERB::Util.url_encode(share_text)}"
%>
<%= link_to wa_href, class: class_names("btn", "btn-secondary", "share-whatsapp"), target: "_blank", rel: "noopener" do %>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.148.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.413-.074-.124-.272-.198-.57-.347" />
    <path d="M12 2a10 10 0 0 0-8.54 15.19L2 22l4.94-1.42A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.42 15.1l-.32-.2-2.93.84.86-2.85-.21-.3A8.2 8.2 0 0 1 12 3.8Z" />
  </svg>
  <%= t("common.share") %>
<% end %>
