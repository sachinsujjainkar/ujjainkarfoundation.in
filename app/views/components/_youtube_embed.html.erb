<%#
  Locals: youtube_id, title (optional, used as the accessible label and the
  eventual iframe title)

  Click-to-load facade -- thumbnail + play button only, on page load. The
  YouTube player JS/iframe is created only once clicked (youtube_embed_
  controller.js). Never self-host video -- one clip going semi-viral on
  WhatsApp costs more than a year of hosting; see
  prompts/phase-06-media-pipeline.md.
%>
<div
  class="relative aspect-video w-full overflow-hidden rounded-card bg-brand-900"
  data-controller="youtube-embed"
  data-youtube-embed-id-value="<%= youtube_id %>"
  data-youtube-embed-title-value="<%= title %>"
>
  <button
    type="button"
    class="group absolute inset-0 flex h-full w-full items-center justify-center"
    data-action="youtube-embed#load"
    aria-label="<%= title.presence || t("common.videos") %>"
  >
    <img
      src="https://i.ytimg.com/vi/<%= youtube_id %>/hqdefault.jpg"
      alt=""
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    >
    <span class="absolute inline-flex size-16 items-center justify-center rounded-full bg-paper/90 text-brand-700 transition-colors duration-150 ease-out group-hover:bg-paper">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7Z" />
      </svg>
    </span>
  </button>
</div>
