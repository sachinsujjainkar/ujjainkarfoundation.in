<div class="flex flex-col">
  <%= render Avo::PanelComponent.new(name: "डॅशबोर्ड", display_breadcrumbs: true) do |c| %>
    <% c.with_body do %>
      <div class="grid grid-cols-1 gap-8 p-6 sm:grid-cols-3 lg:grid-cols-5">
        <%= render "components/stat", value: DevanagariNumerals.convert(@pending_review_count), label: "पुनरावलोकनासाठी प्रलंबित" %>
        <%= render "components/stat", value: DevanagariNumerals.convert(@drafts_count), label: "मसुदे" %>
        <%= render "components/stat", value: DevanagariNumerals.convert(@recently_published_count), label: "अलीकडे प्रकाशित" %>
        <%= render "components/stat", value: DevanagariNumerals.convert(@unread_messages_count), label: "न वाचलेले संदेश" %>
        <%= render "components/stat", value: DevanagariNumerals.convert(@new_volunteers_count), label: "नवीन स्वयंसेवक" %>
      </div>
    <% end %>
  <% end %>
</div>
